# Copy this file to `.env` (not committed — see .gitignore) and adjust if
# your setup differs from the defaults. src/core/config.py loads this.
#
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)

# The model tag Ollama should serve. Must match what you `ollama pull`ed.
OLLAMA_MODEL=llama3.2:3b

# Where Ollama's local API listens. Almost never needs to change.
# The IP literal, not "localhost": on Windows the name costs about 2.2 s per new connection (measured 2026-10-07).
OLLAMA_HOST=http://127.0.0.1:11434

# Leave unset to let Ollama choose (it uses a GPU if there is one). Set 0 to force
# CPU-only inference, e.g. to measure the laptop-without-a-GPU target honestly.
# OLLAMA_NUM_GPU=0

# Generation temperature (Ch1 §1.1.3) — kept low for faithful, citation-
# grounded answers rather than creative variety.
LLM_TEMPERATURE=0.1

# Text embedding model (Ch1 §1.5, ADR discussion in Ch3A Theme 3).
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# CLIP checkpoint (ADR-003).
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# Whisper model size (Ch1 §1.7.6) — smaller is faster, larger is more
# accurate. `base` is the recommended starting point for a laptop CPU.
WHISPER_MODEL_SIZE=base

# Where ChromaDB persists its data on disk.
CHROMA_PERSIST_DIR=./chroma_db

# Offline mode. Set to 1 once the models have been downloaded (the FIRST run
# needs the network once, to fetch them). Without it, every model load tries
# to reach the Hugging Face Hub: with no network that cost ~49 s of retries
# on the first question before falling back to the local cache, and 31
# connection attempts; with it, 0.6 s and none (measured 2026-10-05,
# scripts/verify_offline.py). Turn it on before an offline demo.
RAGNOVA_OFFLINE=0

# Where each audio file's transcript is cached (keyed by the audio's sha256), so
# every machine indexes the same text (ADR-013). Empty disables the cache.
WHISPER_TRANSCRIPT_CACHE_DIR=./data/transcripts

# Chunking parameters (ADR-006) — defaults; Chapter 12's ablation may
# change these.
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50

# How many results to retrieve per query (Ch1 §1.10, ADR discussion).
# 5 is the default and the best on the gold set; on a GPU the extra context is free (0.5 s).
# CPU-ONLY PROFILE (ADR-015): TOP_K=3. The model spends 85% of its time READING the prompt, about
# 150 tokens a second on the CPU measured, so a shorter prompt is the one lever. Measured 2026-10-07
# on an i5-14600K with OLLAMA_NUM_GPU=0: median 15.8 s -> 9.2 s per answer (p90 22.9 -> 14.9 s) against
# the 15 s target, answers no worse on 33 questions, at a retrieval cost of 0.04 Recall@K. A slower
# laptop will be slower in proportion; set OLLAMA_NUM_GPU=0 above to reproduce these numbers.
TOP_K=5

# Relevance floors (ADR-009). The image one is lower on purpose: CLIP's
# text-to-image scores run lower than text-to-text ones (the modality gap,
# ADR-003), so one shared number would filter out every image (Ch12).
MIN_RELEVANCE_SCORE=0.3
MIN_IMAGE_RELEVANCE_SCORE=0.2

# OPTIONAL, OFF BY DEFAULT, NOT RECOMMENDED (ADR-015): CONTEXT_WORDS_PER_CHUNK=120 shows the model only each
# retrieved chunk's best-matching sentences. About a second faster than TOP_K=3, but on 8 held-out questions
# it returned a bare citation marker three times and invented two facts. Leave it at 0.
# CONTEXT_WORDS_PER_CHUNK=0

# OPTIONAL, OFF BY DEFAULT (ADR-014): also search images by the text read from them, and fuse the two
# rankings. Measured 2026-10-07 and not adopted by the pre-registered rule; recovers gold rows I3 and I10
# and changes nothing else on the gold set. Setting only IMAGE_TEXT_SEARCH re-ranks; adding the agreement
# threshold also admits an image whose text matches the question that well even when CLIP does not.
# IMAGE_TEXT_SEARCH=1
# IMAGE_OCR_ONLY_MIN_AGREEMENT=0.45
# IMAGE_OCR_ONLY_NEEDS_SHARED_WORD=0   # tested; it loses I10, so leave it off

# NAMES, TYPOS, FOLLOW-UPS, FULLER ANSWERS: ON BY DEFAULT since 2026-10-11 (ADR-018, adopted after its V8 run; ADR-017).
# LEXICAL_ADMIT puts a chunk first when every distinctive word of the question is literally in it, so names and
# identifiers ("who is Alex Morgan?", "riffy") are found; a title or initial must match as a phrase, so "Who is
# Dr. S. Sharma?" no longer finds Mr. V. Sharma. LEXICAL_MAX_DF is how many files may hold a word before it stops
# being distinctive. PROMPT_WHO_WHAT_RULE: for "who / what is X", say what the context states about X.
# PROMPT_DETAIL_RULE: use the context fully ("in brief" = a short paragraph, not one line).
# QUERY_SPELLING_FIX: "lab rul no. 2" is searched as "lab rules no. 2". Set any of them to 0 to switch it off.
# LEXICAL_ADMIT=1
# LEXICAL_MODE=distinctive
# LEXICAL_MAX_DF=2
# PROMPT_WHO_WHAT_RULE=1
# PROMPT_DETAIL_RULE=1
# QUERY_SPELLING_FIX=1

# THINKING MODELS (gemma4, qwen3, deepseek-r1). Leave LLM_THINK unset for llama3.2 (Ollama rejects `think` for a
# model that cannot think). LLM_THINK=1 lets the model reason first and gives it LLM_THINK_TOKENS extra tokens for
# that (the reasoning is never shown); LLM_THINK=0 switches it off for speed. Without either, gemma4:12b thought by
# default and its reasoning used up the 512-token budget: empty answers (2026-10-11). On a GPU the reasoning costs a
# few seconds per answer; on a CPU-only laptop it is too slow.
# LLM_THINK=1
# LLM_THINK_TOKENS=1536

# Rank-fusion constant for merging text and image results (ADR-007).
RRF_K=60

# Where the chat UI's feedback form appends its entries (Ch11/Ch12).
FEEDBACK_LOG_PATH=./feedback/feedback.jsonl
