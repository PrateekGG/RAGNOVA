# Copy this file to `.env` (not committed — see .gitignore) and adjust if
# your setup differs from the defaults. src/core/config.py loads this.
#
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)

# The model tag Ollama should serve. Must match what you `ollama pull`ed.
OLLAMA_MODEL=llama3.2:3b

# Where Ollama's local API listens. Almost never needs to change.
OLLAMA_HOST=http://localhost:11434

# Leave unset to let Ollama choose (it uses a GPU if there is one). Set 0 to force
# CPU-only inference, e.g. to measure the laptop-without-a-GPU target honestly.
# OLLAMA_NUM_GPU=0

# Generation temperature (Ch1 §1.1.3) — kept low for faithful, citation-
# grounded answers rather than creative variety.
LLM_TEMPERATURE=0.1

# Text embedding model (Ch1 §1.5, ADR discussion in Ch3A Theme 3).
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# CLIP checkpoint (ADR-003).
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# Whisper model size (Ch1 §1.7.6) — smaller is faster, larger is more
# accurate. `base` is the recommended starting point for a laptop CPU.
WHISPER_MODEL_SIZE=base

# Where ChromaDB persists its data on disk.
CHROMA_PERSIST_DIR=./chroma_db

# Offline mode. Set to 1 once the models have been downloaded (the FIRST run
# needs the network once, to fetch them). Without it, every model load tries
# to reach the Hugging Face Hub: with no network that cost ~49 s of retries
# on the first question before falling back to the local cache, and 31
# connection attempts; with it, 0.6 s and none (measured 2026-10-05,
# scripts/verify_offline.py). Turn it on before an offline demo.
RAGNOVA_OFFLINE=0

# Where each audio file's transcript is cached (keyed by the audio's sha256), so
# every machine indexes the same text (ADR-013). Empty disables the cache.
WHISPER_TRANSCRIPT_CACHE_DIR=./data/transcripts

# Chunking parameters (ADR-006) — defaults; Chapter 12's ablation may
# change these.
CHUNK_SIZE_WORDS=300
CHUNK_OVERLAP_WORDS=50

# How many results to retrieve per query (Ch1 §1.10, ADR discussion).
# 5 is the default and the best on the gold set. On a CPU-only laptop, 3 halves the
# end-to-end latency (median 29 s -> 14 s, measured 2026-10-05) at a cost of 0.04
# Recall@K; set OLLAMA_NUM_GPU=0 above to reproduce the CPU-only numbers.
TOP_K=5

# Relevance floors (ADR-009). The image one is lower on purpose: CLIP's
# text-to-image scores run lower than text-to-text ones (the modality gap,
# ADR-003), so one shared number would filter out every image (Ch12).
MIN_RELEVANCE_SCORE=0.3
MIN_IMAGE_RELEVANCE_SCORE=0.2

# Rank-fusion constant for merging text and image results (ADR-007).
RRF_K=60

# Where the chat UI's feedback form appends its entries (Ch11/Ch12).
FEEDBACK_LOG_PATH=./feedback/feedback.jsonl
